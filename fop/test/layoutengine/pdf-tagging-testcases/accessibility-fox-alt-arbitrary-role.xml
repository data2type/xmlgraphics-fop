<!-- $Id$ -->
<testcase>
    <info>
        <p>
            Check that fox:alt attribute is correctly applied as /Alt entry on PDF structure
            elements generated from FO elements with a role attribute (e.g. fo:inline with
            role="Formula"). Previously fox:alt was only respected for a fixed set of
            FO elements; this test verifies the fix that extends support to arbitrary roles.
        </p>
    </info>
    <cfg>
        <fop version="1.0">
            <accessibility>true</accessibility>
        </fop>
    </cfg>
    <fo>
        <fo:root xmlns:fo="http://www.w3.org/1999/XSL/Format"
                 xmlns:fox="http://xmlgraphics.apache.org/fop/extensions">

            <fo:layout-master-set>
                <fo:simple-page-master master-name="A4" page-width="210mm" page-height="297mm"
                                       margin="20mm">
                    <fo:region-body/>
                </fo:simple-page-master>
            </fo:layout-master-set>

            <fo:page-sequence master-reference="A4">
                <fo:flow flow-name="xsl-region-body">

                    <fo:block>
                        <fo:inline role="Formula" fox:alt="x squared plus y squared equals z squared">
                            x&#xB2; + y&#xB2; = z&#xB2;
                        </fo:inline>
                    </fo:block>

                    <fo:block space-before="10mm">
                        <fo:inline role="Figure" fox:alt="A decorative inline figure">
                            &#x25A0;
                        </fo:inline>
                    </fo:block>

                    <fo:block role="Note" fox:alt="This is an important note"
                              space-before="10mm" border="0.5pt solid black" padding="3mm">
                        Note: This paragraph carries an alternate description.
                    </fo:block>

                </fo:flow>
            </fo:page-sequence>
        </fo:root>
    </fo>
    <pdf-tagging-checks>
        <eval expected="x squared plus y squared equals z squared"
              xpath="//Formula/@alternateDescription"/>

        <eval expected="A decorative inline figure"
              xpath="//Figure/@alternateDescription"/>

        <eval expected="This is an important note"
              xpath="//Note/@alternateDescription"/>
    </pdf-tagging-checks>
</testcase>