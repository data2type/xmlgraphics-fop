<testcase>
    <info>
        <p>
            Verify that fox:alt on fo:basic-link is correctly mapped to the /Contents entry
            of the link annotation, and NOT as an /Alt entry on the structure element.
            This prevents "Nested alternate text" errors in accessibility checkers
            when a link contains a figure with its own alt text.
        </p>
    </info>
    <cfg>
        <fop version="1.0">
            <accessibility>true</accessibility>
        </fop>
    </cfg>
    <fo>
        <fo:root xmlns:fo="http://www.w3.org/1999/XSL/Format"
                 xmlns:fox="http://xmlgraphics.apache.org/fop/extensions">
            <fo:layout-master-set>
                <fo:simple-page-master master-name="A4" page-width="210mm" page-height="297mm" margin="20mm">
                    <fo:region-body/>
                </fo:simple-page-master>
            </fo:layout-master-set>

            <fo:page-sequence master-reference="A4">
                <fo:flow flow-name="xsl-region-body">

                    <!-- 1. External Link with fox:alt -->
                    <fo:block>
                        <fo:basic-link external-destination="http://xmlgraphics.apache.org/fop/"
                                       fox:alt-text="FOP Website Home">
                            Apache FOP
                        </fo:basic-link>
                    </fo:block>

                    <!-- 2. Internal Link with fox:alt -->
                    <fo:block space-before="10mm">
                        <fo:basic-link internal-destination="target-desc"
                                       fox:alt-text="Jump to target description">
                            Go to target
                        </fo:basic-link>
                    </fo:block>

                    <!-- 3. Link with Nested Image (Both with fox:alt) -->
                    <fo:block space-before="10mm">
                        <fo:basic-link external-destination="http://example.com"
                                       fox:alt-text="Example Link Wrapper">
                            <fo:external-graphic src="url(data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7)"
                                                 fox:alt-text="Example Image Alt Text"/>
                        </fo:basic-link>
                    </fo:block>

                    <fo:block id="target-desc" space-before="50mm">Target Content</fo:block>

                </fo:flow>
            </fo:page-sequence>
        </fo:root>
    </fo>

    <pdf-tagging-checks>
        <eval expected="FOP Website Home" xpath="(//Link)[1]/@contents"/>
        <eval expected="0" xpath="count(//Link[1]/@alternateDescription)"/>

        <eval expected="Jump to target description" xpath="(//Link)[2]/@contents"/>
        <eval expected="0" xpath="count(//Link[2]/@alternateDescription)"/>

        <eval expected="Example Link Wrapper" xpath="(//Link)[3]/@contents"/>
        <eval expected="0" xpath="count(//Link[3]/@alternateDescription)"/>

        <eval expected="Example Image Alt Text" xpath="(//Link)[3]/Figure/@alternateDescription"/>
    </pdf-tagging-checks>
</testcase>