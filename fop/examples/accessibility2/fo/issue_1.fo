<?xml version="1.0" encoding="UTF-8"?> 
<fo:root xmlns:fo="http://www.w3.org/1999/XSL/Format" xml:lang="en">
    <fo:layout-master-set>
        <fo:simple-page-master master-name="sample">
            <fo:region-body/>
        </fo:simple-page-master>
    </fo:layout-master-set>
    <fo:declarations>
        <x:xmpmeta xmlns:x="adobe:ns:meta/">
            <rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#">
                <rdf:Description rdf:about="" xmlns:dc="http://purl.org/dc/elements/1.1/">
                    <dc:title>A11y sample for FOP issue #1</dc:title>
                </rdf:Description>
            </rdf:RDF>
        </x:xmpmeta>
    </fo:declarations>
    <fo:page-sequence master-reference="sample" font-family="Roboto Mono">
        <fo:flow flow-name="xsl-region-body">
            <fo:block role="">
                <fo:block>block 1</fo:block>
                <fo:block role="">
                    <fo:block>block 2</fo:block>
                </fo:block>
            </fo:block>
            <fo:block>
                <fo:block>block 3</fo:block>
            </fo:block>
            <fo:block>block 4 </fo:block>
            <fo:block role="none">
                <fo:block>block 5</fo:block>
                <fo:block role="none">
                    <fo:block>block 6</fo:block>
                </fo:block>
            </fo:block>
            
            <!--
                Unsure, why this does not work here...
            -->
            <fo:table role="Div">
                <fo:table-body role="">
                    <fo:table-row role="">
                        <fo:table-cell role="">
                            <fo:block role="P">block 7</fo:block>
                        </fo:table-cell>
                    </fo:table-row>
                </fo:table-body>
            </fo:table>
        </fo:flow>
    </fo:page-sequence>
</fo:root>
