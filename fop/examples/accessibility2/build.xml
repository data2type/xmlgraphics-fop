<?xml version="1.0" encoding="UTF-8"?>
<project default="all" basedir="." name="Accessibility Examples">

    <property name="classpathfile" location="${basedir}/.classpath"/>
    <property name="mvnw.dir" location="${basedir}/.mvn"/>
    <property name="testresults" location="${basedir}/_results"/>
    
    
    <path id="mvnw.classpath">
        <fileset dir="${mvnw.dir}">
            <include name="**/*.jar"/>
        </fileset>
    </path>
    
    <target name="init">
        <echo message="${basedir}/pom.xml"/>
        <echo message="${classpathfile}"/>
        <java classpath="${toString:mvnw.classpath}" classname="org.apache.maven.wrapper.MavenWrapperMain" fork="true">
            <sysproperty key="maven.multiModuleProjectDirectory" path="fop"/>
            <arg line="-f ${basedir}/pom.xml"/>
            <arg value="dependency:build-classpath"/>
            <arg value="-Dmdep.outputFile=${classpathfile}"/>
        </java>
        
        <loadfile property="classpath" srcfile="${classpathfile}"/>

        <mkdir dir="${testresults}"/>
    </target>

    <target name="i_1" depends="init">
        <issue id="1"/>
    </target>
    <target name="i_2" depends="init">
        <issue id="2"/>
    </target>
    <target name="i_3" depends="init">
        <issue id="3"/>
    </target>
    <target name="i_4" depends="init">
        <issue id="4"/>
    </target>
    <target name="i_5" depends="init">
        <issue id="5"/>
    </target>
    <target name="i_6" depends="init">
        <issue id="6"/>
    </target>
    <target name="i_7" depends="init">
        <issue id="7"/>
        <issue id="7b"/>
    </target>
    <target name="i_8" depends="init">
        <issue id="8"/>
    </target>
    <target name="i_9" depends="init">
        <issue id="9"/>
    </target>
    
    <target name="i_10" depends="init">
        <java classname="org.apache.fop.cli.Main" classpath="${classpath}" failonerror="false"
            fork="true">
            <arg line='-c "${basedir}/cfg/fop_ua.xconf"'/>
            <arg line='-fo "${basedir}/fo/issue_10.fo"'/>
            <arg line='-out application/X-fop-intermediate-format "${testresults}/issue_10.xml"'/>
        </java>
    </target>
    
    <target name="i_13" depends="init">
        <java classname="org.apache.fop.cli.Main" classpath="${classpath}" failonerror="false"
            fork="true">
            <arg line='-c "${basedir}/cfg/fop_ua.xconf"'/>
            <arg line='-fo "${basedir}/fo/issue_13.fo"'/>
            <arg line='-at application/pdf "${testresults}/issue_13.at.xml"'/>
        </java>
    </target>
    
    <target name="all" depends="i_1, i_2, i_3, i_4, i_5, i_6, i_7, i_8, i_9, i_10"/>

    <macrodef name="issue">
        <attribute name="id"/>
        <attribute name="config" default="fop_ua"/>
        <sequential>
            <java classname="org.apache.fop.cli.Main" classpath="${classpath}" failonerror="false"
                fork="true">
                <arg line='-c "${basedir}/cfg/@{config}.xconf"'/>
                <arg line='-fo "${basedir}/fo/issue_@{id}.fo"'/>
                <arg line='-pdf "${testresults}/issue_@{id}.pdf"'/>
            </java>
        </sequential>
    </macrodef>

</project>
